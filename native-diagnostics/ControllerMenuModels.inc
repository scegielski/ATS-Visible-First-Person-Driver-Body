void HideMenuControllerModels(){std::array<ControllerMeshPose,64> poses{};SubmitMenuModelPoses(poses);}
void DestroyMenuControllerModels(){HideMenuControllerModels();for(auto& hand:menuModelHands)FreeMenuModelHand(hand);}
